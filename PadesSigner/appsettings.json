{
  // Folders. Environment variables (%USERPROFILE%, ...) are expanded; relative paths are relative to the exe.
  "InputFolder": "%USERPROFILE%\\PadesSigner\\Input",
  "OutputFolder": "%USERPROFILE%\\PadesSigner\\Output",
  // Originals are moved here after successful signing. Leave empty to delete them instead.
  "ProcessedFolder": "%USERPROFILE%\\PadesSigner\\Processed",
  // Files that fail to sign are moved here together with a .error.txt describing the problem.
  "ErrorFolder": "%USERPROFILE%\\PadesSigner\\Error",
  // Appended to the output file name: invoice.pdf -> invoice_signed.pdf. May be empty.
  "OutputSuffix": "_signed",
  // Safety net: the input folder is re-scanned this often in case a file system event was missed.
  "RescanIntervalSeconds": 30,

  "Certificate": {
    // Store = Windows certificate store (imported .pfx, smart cards, USB tokens) - recommended
    // Pfx   = PKCS#12 file (.pfx / .p12) + password
    // Pem   = certificate .pem/.crt (may contain the chain) + private key .pem (optionally encrypted)
    "Source": "Store",

    // Empty = use the only valid signing certificate in the store (newest one after a renewal).
    // If there are several: right-click the tray icon > Choose certificate (fills this in), see CERTIFICATE-SETUP.txt.
    "StoreThumbprint": "",
    // CurrentUser or LocalMachine
    "StoreLocation": "CurrentUser",

    "PfxPath": "",
    // If empty, the environment variable PADES_SIGNER_PASSWORD is used.
    "PfxPassword": "",

    "PemCertPath": "",
    "PemKeyPath": "",
    "PemKeyPassword": ""
  },

  "Signature": {
    // PAdES baseline level: B-B, B-T, B-LT or B-LTA. Everything above B-B requires TsaUrl.
    "Level": "B-B",
    "DigestAlgorithm": "SHA-256",
    "TsaUrl": "",
    "TsaUser": "",
    "TsaPassword": "",
    "Reason": "",
    "Location": "",
    "Contact": ""
  }
}
